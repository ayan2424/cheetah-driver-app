              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "fcm_token", "value": "dK8_fcm_sample_device_registration_token_12345", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}api/v1/driver/update_fcm_token.php",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "update_fcm_token.php"]
            },
            "description": "Registers device Firebase Cloud Messaging token for targeted background dispatch alerts."
          }
        }
      ]
    },
    {
      "name": "3. Warehouse Picker Operations",
      "item": [
        {
          "name": "Fetch WMS Pick Tasks",
          "request": {
            "method": "POST",
            "header": [
